# Set these in Vercel server-side environment variables and in .env.local for vercel dev.
# Never use VITE_ prefixes for these variables.
RESEND_API_KEY=
CONTACT_FROM="Eleven B Site-Sense <info@elevenbsitesense.com>"
CONTACT_TO=info@elevenbsitesense.com
AUTOREPLY=true

# Upstash Redis REST credentials for distributed rate limits and delivery receipts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional additional, exact HTTPS origins. Production origins are built in.
# Current Vercel preview URLs and local development origins are added by runtime context.
CONTACT_ALLOWED_ORIGINS=
